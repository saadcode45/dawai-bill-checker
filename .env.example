# Dawai Bill Checker — copy to .env.local for local dev, or set these in
# Vercel > Project > Settings > Environment Variables.
# NEVER commit real keys. .env.local is git-ignored by default.

# Supabase project (public — safe in the browser). Same project Memora uses:
NEXT_PUBLIC_SUPABASE_URL=https://dzqmpwjarunwjskmjzcm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — never expose in client code).
# Only needed if a server route needs it; the app works with the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (SERVER ONLY — used by /api/read-slip to read the
# doctor's slip photo). Without it, photo upload returns 503 and patients
# use typing mode instead.
GEMINI_API_KEY=
